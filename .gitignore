# simulation output (regenerated by the scripts); the compact archive in data/ is kept
*.npz
*.npy
*.log
!data/**/*.npz
!data/**/*.npy

# manuscript sources stay out of the repository
*.tex
*.bib
*.bbl
*.blg
*.aux

# Python
__pycache__/
*.pyc

# scratch output written next to the code
code/*.png
code/*.html
